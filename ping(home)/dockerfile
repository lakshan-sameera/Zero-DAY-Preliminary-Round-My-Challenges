# Use a lightweight Python image
FROM python:3.9-slim

# Install dependencies:
# - iptables: to configure the firewall
# - dnsutils: provides 'dig' (critical for the solution)
# - curl: used by the vulnerable app
RUN apt-get update && apt-get install -y \
    iptables \
    dnsutils \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Flask
RUN pip install flask

# Set up the challenge directory
WORKDIR /app

# Copy our files
COPY app.py .
COPY entrypoint.sh .

# Make the entrypoint executable
RUN chmod +x entrypoint.sh

# Create the Flag
RUN echo "0DAY{Blind_ssrf_WITh_COmmand_INjection!!}" > /flag

# Expose the web port
EXPOSE 5000

# Use the entrypoint script to start
ENTRYPOINT ["./entrypoint.sh"]